# "Ask my portfolio" chat. Copy to .env.local for local work; set the same names in Vercel.
# Server-side only: none of these is exposed to the browser except the Turnstile SITE key.

# Kill switch. Anything other than "true" or "1" turns the assistant off: /api/ask answers 503
# and the launcher hides itself.
ASK_ENABLED=false

# n8n production webhook (not the test URL) and the shared secret n8n checks in the
# X-Portfolio-Secret header. Use a long random value, the same one as in the n8n credential.
N8N_ASK_URL=https://YOUR-N8N-HOST/webhook/ask-portfolio
N8N_ASK_SECRET=

# Which n8n workflow the site talks to. "stuffing" (default) sends all site content with each question,
# for ask-portfolio.workflow.json. "agent" sends only a short profile, for ask-portfolio-agent.workflow.json,
# whose AI agent looks details up in a vector store filled by ask-portfolio-ingest.workflow.json.
ASK_MODE=stuffing

# Cloudflare Turnstile. The secret key turns the bot challenge on; leave both empty to skip it.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Rate limiting store: Vercel's Redis integration (Upstash) sets these two. Without them the route
# uses an in-memory counter, which is fine locally but only per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional tuning (defaults shown). Keep the daily cap under your Gemini free-tier daily quota.
ASK_IP_LIMIT=10
ASK_IP_WINDOW_SECONDS=600
ASK_DAILY_CAP=300
