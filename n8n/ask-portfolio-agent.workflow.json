    {
      "parameters": {
        "jsCode": "// Rejects anything the Next.js route should already have filtered. Defence in depth.\nconst cfg = $('Config').first().json;\nconst body = $input.first().json.body || {};\nconst fail = (error) => [{ json: { valid: false, error } }];\n\nconst messages = body.messages;\nif (!Array.isArray(messages) || messages.length === 0 || messages.length > cfg.maxTurns) {\n  return fail('Invalid messages.');\n}\nlet total = 0;\nfor (const m of messages) {\n  const roleOk = m && (m.role === 'user' || m.role === 'model');\n  if (!roleOk || typeof m.content !== 'string' || !m.content.trim()) return fail('Invalid message.');\n  total += m.content.length;\n}\nconst last = messages[messages.length - 1];\nif (last.role !== 'user' || last.content.length > cfg.maxLast) return fail('Question is too long.');\nif (total > cfg.maxTotal) return fail('Conversation is too long.');\n\nconst profile = body.profile;\nif (typeof profile !== 'string' || profile.length < 100 || profile.length > cfg.maxProfileChars) {\n  return fail('Missing or oversized profile.');\n}\nreturn [{ json: { valid: true, messages, profile } }];"
      },
      "id": "e4a5237c-6dbc-54a9-8e76-796083dfbc65",
      "name": "Validate",
