    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst data = $input.first().json || {};\nconst fallback =\n  \"Sorry, I couldn't answer that. You can reach Karan at \" + cfg.contactEmail + \".\";\n\n// The AI Agent node returns its answer in `output`.\nconst text = typeof data.output === 'string' ? data.output.trim() : '';\nif (!text) return [{ json: { reply: fallback } }];\nreturn [{ json: { reply: text.slice(0, 2000) } }];"
      },
